# Copiar este archivo como ".env" en la raíz del proyecto (NO subir el .env real a GitHub)

SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Usuario administrador: único que puede descargar Excel / historial
USER1_NAME=Admin
USER1_HASH=pega_aqui_el_hash_generado_con_generate-hash.js

USER2_NAME=operador1
USER2_HASH=pega_aqui_el_hash_generado_con_generate-hash.js

USER3_NAME=operador2
USER3_HASH=pega_aqui_el_hash_generado_con_generate-hash.js

# MQTT (opcional). Por defecto ambos sistemas usan mqtt://localhost:1883
# MQTT_URL=mqtt://localhost:1883
# MQTT_URL_MATRIZ=mqtt://localhost:1883
# MQTT_URL_NITRATO=mqtt://IP_BROKER_NITRATO:1883
# MQTT_TOPIC_MATRIZ=planta/losbronces/silos/#
# Nitrato: planta/losbronces/silos/tanque11 … tanque18 = Silo 1 … Silo 8 Nitrato
# MQTT_TOPIC_NITRATO=planta/losbronces/silos/#

# Nitrato: densidad (kg/m³), igual que la planilla (por defecto 750)
# NITRATO_DENSIDAD=750

# Nitrato: masa residual (t) que debe mostrar un silo vacío. Ajuste empírico de la tolva (por defecto 0.10)
# NITRATO_MASA_VACIO_TON=0.10

# KPI: umbral mínimo de ruido (t) y masa mínima para contar una recarga (t)
# KPI_UMBRAL_TON=0.3
# KPI_RECARGA_MIN_TON=2
# Recarga = subida gradual de al menos N pasos (por defecto 3, ≈15 min)
# KPI_RECARGA_MIN_PASOS=3
# Salto (corte de energía / reinicio): cambio mayor a X % de capacidad cada 5 min (por defecto 10)
# KPI_SALTO_PCT=10

# Usuarios administradores, separados por coma (por defecto: Admin)
# ADMIN_USERS=Admin

# Puerto del servidor (por defecto 3000)
# PORT=3000

# Publicación con dominio + HTTPS detrás de Nginx (ver README):
# HOST=127.0.0.1
# HTTPS_PROXY_MODE=true

# Multiplanta: portal argoss.cl con selección de planta (ver README)
# Planta que atiende este servidor (debe coincidir con un "id" de plantas.json; por defecto lossauces)
# PLANTA_ID=lossauces
# Portal de selección de planta: un login fallido desde el portal y "Cerrar sesión" vuelven aquí
# PORTAL_URL=https://argoss.cl
